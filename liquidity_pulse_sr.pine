//@version=6
// max_bars_back covers the deepest historical reference the rebuild makes:
// srLookback - 1 + leftBars. At the 1000-bar input ceiling that is 1009.
indicator("Liquidity-Pulse - S/R Clusters & VPOC", shorttitle="LiqPulse", overlay=true, max_lines_count=100, max_labels_count=100, max_bars_back=1100)

// ============================================================================
// INPUT PARAMETERS
// ============================================================================
leftBars         = input.int(10, title="Pivot Left Bars", minval=1, group="Pivot Settings")
rightBars        = input.int(10, title="Pivot Right Bars", minval=1, group="Pivot Settings")
clusterPct       = input.float(0.35, title="Cluster Density Threshold (%)", minval=0.05, step=0.05, group="Density Settings") / 100.0
drawLevels       = input.int(12, title="Levels To Draw (nearest price)", minval=1, maxval=40, group="Display Settings")
minTouchesHigh   = input.int(3, title="Min Touches for High Conviction", minval=2, group="Conviction Settings")
srLookback       = input.int(500, title="S/R Lookback Bars", minval=50, maxval=1000, group="Pivot Settings", tooltip="Trailing window the pivots, clusters and touch counts are rebuilt over on every bar. Matches the limit=500 candle window quant_engine.py analyses, so chart levels and touch counts agree with the backend telemetry.")
showLabels       = input.bool(true, title="Show Conviction Labels", group="Display Settings")
showVPOC         = input.bool(true, title="Show VPOC Line", group="Display Settings")
vpocBars         = input.int(500, title="VPOC Lookback Bars", minval=50, maxval=500, group="Display Settings")
vpocBins         = input.int(50, title="VPOC Histogram Bins", minval=10, maxval=200, group="Display Settings")
showTable        = input.bool(true, title="Show S/R Telemetry Table", group="Display Settings")
levelExtend      = input.string("Both", title="Level Line Extension", options=["Both", "Right", "Segment"], group="Display Settings", tooltip="Both/Right extend the level across the whole chart so it tracks any zoom or resize. Segment draws a fixed 120-bar stub.")

// Colors
colorSupport     = input.color(color.new(#00e676, 20), title="Support Color", group="Color Settings")
colorResistance  = input.color(color.new(#ff1744, 20), title="Resistance Color", group="Color Settings")
colorVPOC        = input.color(color.new(#ffd700, 0), title="VPOC Color", group="Color Settings")

// A level is a horizontal price, not a bar range. Extending it means the line
// spans the whole viewport at any zoom instead of stopping at a fixed bar
// offset near the right edge.
extendMode = levelExtend == "Both" ? extend.both : levelExtend == "Right" ? extend.right : extend.none

// Linear-interpolated percentile, matching numpy.percentile's default so the
// HVN threshold here and in calculate_volume_profile() agree.
percentileLinear(array<float> src, float pct) =>
    array<float> sorted = array.copy(src)
    array.sort(sorted, order.ascending)
    int   n    = array.size(sorted)
    float pos  = (n - 1) * pct
    int   lo   = int(math.floor(pos))
    int   hi   = int(math.ceil(pos))
    float frac = pos - lo
    array.get(sorted, lo) * (1.0 - frac) + array.get(sorted, hi) * frac

// Mirrors apply_volume_confluence() in src/quant_engine.py: a level has volume
// confluence when it sits within 0.5% of the VPOC or of any high-volume node.
volumeConfluence(float px, float ref, float vpocPx, array<float> volBins, float hvnFloor, float lo, float w) =>
    bool hit = math.abs(px - vpocPx) / ref <= 0.005
    if not hit and not na(hvnFloor) and w > 0
        for i = 0 to array.size(volBins) - 1
            if not hit and array.get(volBins, i) >= hvnFloor
                float centre = lo + (i + 0.5) * w
                if math.abs(px - centre) / ref <= 0.005
                    hit := true
    hit

// ============================================================================
// PINE PIVOT DETECTION
// ============================================================================
// Pivots are found inside rebuildLevels() by scanning the window directly rather
// than by ta.pivothigh/ta.pivotlow. The built-ins report a pivot once, on the bar
// it confirms, which only suits an accumulator; a rebuild needs every pivot in the
// window on every pass, and needs the same strict-older / inclusive-newer
// comparison calculate_pine_pivots() uses.

var array<float> pivotPrices  = array.new_float(0)   // cluster centre price (mean of members)
var array<int>   pivotTouches = array.new_int(0)     // distinct zone entries over the window
var array<int>   pivotMembers = array.new_int(0)     // pivots merged into this cluster
var array<line>  levelLines   = array.new_line(0)
var array<label> levelLabels  = array.new_label(0)
var line    vpocLine     = na
var label   vpocLbl      = na

// Volume profile state, refreshed on the last bar. Held at global scope because
// the alert pass runs outside the draw block and must grade conviction with the
// same volume-acceptance test the labels and table use.
var float        vpocPrice = na
var float        hvnFloor  = na
var float        profLoMid = na
var float        profBinW  = na
var array<float> volBins   = array.new_float(0)

// Merge one pivot into the cluster list, mirroring cluster_sr_levels() in
// src/quant_engine.py: walk the clusters in creation order and take the first
// whose running centre is within the density threshold, otherwise start a new
// one. The centre is the arithmetic mean of the cluster's members, so the number
// here and the number in the telemetry are the same number.
mergePivot(array<float> centres, array<int> members, float px) =>
    int hit = -1
    if array.size(centres) > 0
        for i = 0 to array.size(centres) - 1
            centre = array.get(centres, i)
            if hit < 0 and math.abs(px - centre) / centre <= clusterPct
                hit := i
    if hit >= 0
        n      = array.get(members, hit)
        centre = array.get(centres, hit)
        array.set(centres, hit, (centre * n + px) / (n + 1))
        array.set(members, hit, n + 1)
    else
        array.push(centres, px)
        array.push(members, 1)
    true

// Rebuild every cluster and touch count from scratch over the trailing window.
//
// This replaces an incremental accumulator, and the reason is worth keeping. That
// version created a cluster with touches = 1 on the bar its first pivot confirmed
// and counted re-entries only from that bar onward, against a centre that kept
// moving as later pivots merged in. Nothing aged a cluster out either — the old
// `inWindow` gate limited accumulation, not retention — so the level set silently
// widened the longer a chart stayed open.
//
// Both made the chart path-dependent: identical candles produced different touch
// counts depending on when the indicator was loaded, and neither number matched
// the backend, which re-derives from a fixed window on every run. Measured against
// a live chart, all twelve drawn levels disagreed with the dashboard — one by five
// touches, one tier outright (LOW on the chart, MEDIUM in the briefing) — and one
// pair of backend levels had merged into a single drawn line.
//
// Rebuilding is what the backend does. Cost is O(window x (leftBars + rightBars))
// for the pivot scan plus O(window x clusters) for the touches, on the last bar
// only, which is a few tens of thousands of iterations.
//
// There is deliberately no maximum-levels cap any more. The old eviction of the
// weakest cluster had no counterpart in quant_engine.py, and a full rebuild over a
// bounded window cannot run away the way forever-accumulating state could.
rebuildLevels(array<float> centres, array<int> touches, array<int> members) =>
    array.clear(centres)
    array.clear(touches)
    array.clear(members)

    // Deepest reference below is high[lookback - 1 + leftBars], so the window has
    // to leave room for the lead-in the oldest pivot needs.
    int lookback = math.min(srLookback, bar_index + 1 - leftBars)

    if lookback > leftBars + rightBars
        // Offset p counts bars back from the current bar, so descending p walks
        // forward in time. A pivot at p is compared against leftBars older bars
        // (p + k) and rightBars newer ones (p - k). Strict on the older side,
        // inclusive on the newer, matching calculate_pine_pivots().
        for p = lookback - 1 to rightBars
            float hv = high[p]
            bool isHigh = true
            for k = 1 to leftBars
                if hv <= high[p + k]
                    isHigh := false
            for k = 1 to rightBars
                if hv < high[p - k]
                    isHigh := false
            if isHigh
                mergePivot(centres, members, hv)

            float lv = low[p]
            bool isLow = true
            for k = 1 to leftBars
                if lv >= low[p + k]
                    isLow := false
            for k = 1 to rightBars
                if lv > low[p - k]
                    isLow := false
            if isLow
                mergePivot(centres, members, lv)

        // Touches, counted against the finished centres over the same window. A
        // touch is a bar entering the zone from outside; bars that merely sit
        // inside it add nothing. The first bar of the window counts if it is
        // already inside, matching the backend's entered_from_outside mask.
        int n = array.size(centres)
        if n > 0
            array<bool> inZone = array.new_bool(n, false)
            for i = 0 to n - 1
                array.push(touches, 0)
            bool firstBar = true
            for b = lookback - 1 to 0
                for i = 0 to n - 1
                    float c   = array.get(centres, i)
                    float tol = c * clusterPct
                    bool  now = low[b] <= (c + tol) and high[b] >= (c - tol)
                    if now and (firstBar or not array.get(inZone, i))
                        array.set(touches, i, array.get(touches, i) + 1)
                    array.set(inZone, i, now)
                firstBar := false
    true

// ============================================================================
// DRAW S/R OVERLAYS ON LAST BAR
// ============================================================================
var array<int> drawOrder = array.new_int(0)

if barstate.islast
    // Levels are rebuilt here, not accumulated bar by bar, so this is the only
    // place they exist. The alert pass below reads what this leaves behind.
    rebuildLevels(pivotPrices, pivotTouches, pivotMembers)

    // Clear old lines and labels
    if array.size(levelLines) > 0
        for i = 0 to array.size(levelLines) - 1
            line.delete(array.get(levelLines, i))
        array.clear(levelLines)

    if array.size(levelLabels) > 0
        for i = 0 to array.size(levelLabels) - 1
            label.delete(array.get(levelLabels, i))
        array.clear(levelLabels)

    line.delete(vpocLine)
    label.delete(vpocLbl)

    int xLeft = math.max(0, bar_index - 100)
    int pSize = array.size(pivotPrices)

    // Rank levels by proximity to price (the ordering the backend telemetry
    // uses) rather than by insertion order.
    array.clear(drawOrder)
    if pSize > 0
        array<float> dist = array.new_float(0)
        for i = 0 to pSize - 1
            array.push(dist, math.abs(array.get(pivotPrices, i) - close))
        int take = math.min(pSize, drawLevels)
        for n = 0 to take - 1
            int   best    = -1
            float bestVal = -1.0
            for i = 0 to pSize - 1
                d = array.get(dist, i)
                if d >= 0 and (best < 0 or d < bestVal)
                    best    := i
                    bestVal := d
            if best >= 0
                array.push(drawOrder, best)
                array.set(dist, best, -1.0)

    // ========================================================================
    // VOLUME PROFILE
    // ========================================================================
    // Volume-weighted histogram over candle mid-prices, matching
    // calculate_volume_profile() in src/quant_engine.py (50 bins / 500 bars) so
    // the charted VPOC agrees with workspace/telemetry_latest.json. Computed
    // here rather than in the VPOC draw block because conviction depends on it
    // and must be graded before the labels are built.
    int   scanBars = math.min(bar_index + 1, vpocBars)
    float loMid    = na
    float hiMid    = na
    for j = 0 to scanBars - 1
        m = (high[j] + low[j]) / 2.0
        loMid := na(loMid) ? m : math.min(loMid, m)
        hiMid := na(hiMid) ? m : math.max(hiMid, m)

    profLoMid := loMid
    profBinW  := (hiMid - loMid) / vpocBins
    vpocPrice := close
    hvnFloor  := na
    volBins   := array.new_float(vpocBins, 0.0)
    if profBinW > 0
        for j = 0 to scanBars - 1
            m   = (high[j] + low[j]) / 2.0
            idx = math.min(vpocBins - 1, int(math.floor((m - loMid) / profBinW)))
            array.set(volBins, idx, array.get(volBins, idx) + volume[j])
        int maxIdx = array.indexof(volBins, array.max(volBins))
        vpocPrice := loMid + (maxIdx + 0.5) * profBinW
        // HVN = bins at or above the 80th percentile, as in the backend.
        hvnFloor  := percentileLinear(volBins, 0.80)

    // Render active S/R cluster lines
    if array.size(drawOrder) > 0
        for n = 0 to array.size(drawOrder) - 1
            int    idx        = array.get(drawOrder, n)
            float  levelPrice = array.get(pivotPrices, idx)
            int    touches    = array.get(pivotTouches, idx)
            bool   isSupport  = levelPrice < close
            color  lineColor  = isSupport ? colorSupport : colorResistance
            // grade_conviction(): HIGH needs the touch count AND volume acceptance.
            // Touch count alone never reaches HIGH.
            bool   volConf    = volumeConfluence(levelPrice, close, vpocPrice, volBins, hvnFloor, profLoMid, profBinW)
            bool   isHigh     = touches >= minTouchesHigh and volConf
            string lineStyle  = isHigh ? line.style_solid : line.style_dashed
            int    lineWidth  = isHigh ? 2 : 1

            // Draw line
            line l = line.new(
                 x1=xLeft, y1=levelPrice,
                 x2=bar_index + 20, y2=levelPrice,
                 extend=extendMode,
                 color=lineColor, style=lineStyle, width=lineWidth
                 )
            array.push(levelLines, l)

            // Draw Label
            if showLabels
                string convText = isHigh ? "HIGH" : touches >= 2 ? "MED" : "LOW"
                string labelText = (isSupport ? "SUP: $" : "RES: $") + str.tostring(levelPrice, "#,###.00") + " (" + convText + " - " + str.tostring(touches) + "t)"
                label lbl = label.new(
                     x=bar_index + 22, y=levelPrice,
                     text=labelText, color=color.new(lineColor, 80),
                     textcolor=color.white, style=label.style_label_left, size=size.small
                     )
                array.push(levelLabels, lbl)

    // ========================================================================
    // DRAW VPOC LINE
    // ========================================================================
    if showVPOC and profBinW > 0
        vpocLine := line.new(
             x1=xLeft, y1=vpocPrice,
             x2=bar_index + 30, y2=vpocPrice,
             extend=extendMode,
             color=colorVPOC, style=line.style_solid, width=3
             )
        vpocLbl := label.new(
             x=bar_index + 32, y=vpocPrice,
             text="VPOC (Fair Value): $" + str.tostring(vpocPrice, "#,###.00"),
             color=color.new(colorVPOC, 20), textcolor=color.black,
             style=label.style_label_left, size=size.small
             )

    // ========================================================================
    // S/R TELEMETRY TABLE
    // ========================================================================
    if showTable
        var table srTable = table.new(position.top_right, 4, 11, border_width=1)
        table.clear(srTable, 0, 0, 3, 10)
        table.cell(srTable, 0, 0, "LEVEL",  text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.tiny)
        table.cell(srTable, 1, 0, "TYPE",   text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.tiny)
        table.cell(srTable, 2, 0, "TOUCH",  text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.tiny)
        table.cell(srTable, 3, 0, "DIST %", text_color=color.white, bgcolor=color.new(color.black, 20), text_size=size.tiny)
        if array.size(drawOrder) > 0
            int rows = math.min(array.size(drawOrder), 10)
            for n = 0 to rows - 1
                int   idx     = array.get(drawOrder, n)
                float lvl     = array.get(pivotPrices, idx)
                int   touches = array.get(pivotTouches, idx)
                bool  isSup   = lvl < close
                bool  rowHigh = touches >= minTouchesHigh and volumeConfluence(lvl, close, vpocPrice, volBins, hvnFloor, profLoMid, profBinW)
                color rowCol  = rowHigh ? (isSup ? colorSupport : colorResistance) : color.new(color.gray, 60)
                table.cell(srTable, 0, n + 1, str.tostring(lvl, "#,###.00"),                       text_color=color.white, bgcolor=color.new(rowCol, 70), text_size=size.tiny)
                table.cell(srTable, 1, n + 1, isSup ? "SUP" : "RES",                               text_color=color.white, bgcolor=color.new(rowCol, 70), text_size=size.tiny)
                table.cell(srTable, 2, n + 1, str.tostring(touches),                               text_color=color.white, bgcolor=color.new(rowCol, 70), text_size=size.tiny)
                table.cell(srTable, 3, n + 1, str.tostring((lvl - close) / close * 100.0, "0.00"), text_color=color.white, bgcolor=color.new(rowCol, 70), text_size=size.tiny)

// ============================================================================
// TRADINGVIEW WEBHOOK ALERT CONDITIONS
// ============================================================================
// Read-only pass over every tracked level (the draw pass only shows the nearest
// few, but a level does not stop being tradeable because it is off-screen).
bool  alertSupportTouch    = false
bool  alertResistanceTouch = false
float alertLevel           = 0.0
int   alertTouches         = 0

if array.size(pivotPrices) > 0
    for k = 0 to array.size(pivotPrices) - 1
        lvlP = array.get(pivotPrices, k)
        lvlT = array.get(pivotTouches, k)
        tolP = lvlP * clusterPct
        bool lvlConf = na(profBinW) or profBinW <= 0 ? true : volumeConfluence(lvlP, close, vpocPrice, volBins, hvnFloor, profLoMid, profBinW)
        if lvlT >= minTouchesHigh and lvlConf
            if lvlP < close and low <= (lvlP + tolP) and low[1] > (lvlP + tolP)
                alertSupportTouch := true
                alertLevel        := lvlP
                alertTouches      := lvlT
            if lvlP > close and high >= (lvlP - tolP) and high[1] < (lvlP - tolP)
                alertResistanceTouch := true
                alertLevel           := lvlP
                alertTouches         := lvlT

// Dynamic payloads (fire these via the "Any alert() function call" condition)
// carry the actual level price and touch count, which the const-string
// alertcondition() message below cannot express.
if alertSupportTouch
    alert('{"symbol":"' + syminfo.ticker + '","event":"SUPPORT_TOUCH","level_type":"SUPPORT","price":' + str.tostring(close, "0.00") + ',"level":' + str.tostring(alertLevel, "0.00") + ',"touch_count":' + str.tostring(alertTouches) + ',"conviction":"HIGH","message":"Price tested High Conviction Support level"}', alert.freq_once_per_bar_close)

if alertResistanceTouch
    alert('{"symbol":"' + syminfo.ticker + '","event":"RESISTANCE_TOUCH","level_type":"RESISTANCE","price":' + str.tostring(close, "0.00") + ',"level":' + str.tostring(alertLevel, "0.00") + ',"touch_count":' + str.tostring(alertTouches) + ',"conviction":"HIGH","message":"Price tested High Conviction Resistance level"}', alert.freq_once_per_bar_close)

alertcondition(alertSupportTouch, title="Liquidity-Pulse: Support Touch", message='{"symbol":"{{ticker}}","event":"SUPPORT_TOUCH","level_type":"SUPPORT","price":{{close}},"conviction":"HIGH","message":"Price tested High Conviction Support level"}')
alertcondition(alertResistanceTouch, title="Liquidity-Pulse: Resistance Touch", message='{"symbol":"{{ticker}}","event":"RESISTANCE_TOUCH","level_type":"RESISTANCE","price":{{close}},"conviction":"HIGH","message":"Price tested High Conviction Resistance level"}')
